{
	"name": "gracely",
	"version": "2.0.13",
	"description": "Graceful error handling for REST API:s.",
	"author": "Utily Contributors",
	"license": "MIT",
	"private": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/utily/gracely"
	},
	"bugs": {
		"url": "https://github.com/utily/gracely/issues"
	},
	"homepage": "https://github.com/utily",
	"type": "module",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"git": {
		"tagName": "release-${version}"
	},
	"github": {
		"release": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"lint": "biome format .",
		"format": "biome format --write .",
		"test": "vitest --run",
		"coverage": "vitest --coverage",
		"prepare": "npm run build",
		"clean": "rimraf dist node_modules coverage",
		"verify": "npm run build && npm run test && npm run lint && npm audit --omit=dev"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@vitest/coverage-v8": "5.1.2",
		"rimraf": "6.1.4",
		"semantic-release": "26.0.1",
		"typescript": "7.0.2",
		"vite": "8.4.0",
		"vitest": "5.1.2"
	},
	"dependencies": {}
}
